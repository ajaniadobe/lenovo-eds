  },
  {
   "section": "series-blade2",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Your Power, Your Way"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Investing in a Legion Tower means staying ahead of the tech curve. With a tool-free side panel, you gain instant access to your tower’s inner components, so you can future-proof as your ambitions get bigger, whether that means more storage or a better GPU."
    },
    {
     "role": "body",
     "order": 2,
     "text": "open in new tab"
    }
   ],
   "imgCount": 1,
   "editableTexts": 2,
