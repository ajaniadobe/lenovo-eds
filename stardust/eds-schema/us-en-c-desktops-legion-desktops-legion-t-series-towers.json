  {
   "section": "series-blade2",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Whisper-Quiet Performance"
    },
    {
     "role": "body",
     "order": 1,
     "text": "These towers are the epitome of staying cool under pressure. Employing an innovative thermal architecture with streamlined air intake (and optional liquid cooling on some models), Lenovo Legion towers keep your CPU and GPU cool even in the most demanding sessions."
    },
    {
     "role": "body",
     "order": 2,
     "text": "open in new tab"
    }
   ],
   "imgCount": 1,
